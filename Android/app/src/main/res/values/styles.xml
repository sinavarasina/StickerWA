<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Default application theme pointing to Catppuccin -->
    <style name="AppTheme" parent="AppTheme.Catppuccin" />

    <!-- Catppuccin Theme (Light: Latte) -->
    <style name="Base.AppTheme.Catppuccin" parent="Theme.MaterialComponents.DayNight">
        <item name="colorPrimary">@color/catppuccin_latte_mauve</item>
        <item name="colorPrimaryVariant">@color/catppuccin_latte_mauve</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/catppuccin_latte_green</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorAccent">@color/catppuccin_latte_mauve</item>

        <item name="android:windowBackground">@color/catppuccin_latte_base</item>
        <item name="colorSurface">@color/catppuccin_latte_mantle</item>
        <item name="colorOnSurface">@color/catppuccin_latte_text</item>
        <item name="android:textColorPrimary">@color/catppuccin_latte_text</item>
        <item name="android:textColorSecondary">@color/catppuccin_latte_subtext0</item>

        <!-- Custom Material UI Palette Attributes -->
        <item name="colorCardSurface">#FFFFFF</item>
        <item name="colorCardBorder">@color/catppuccin_latte_surface0</item>
        <item name="colorBadgeBackground">@color/catppuccin_latte_surface0</item>
        <item name="colorBadgeText">@color/catppuccin_latte_mauve</item>
        <item name="colorDivider">@color/catppuccin_latte_surface0</item>
        <item name="colorAddButtonBackground">@color/catppuccin_latte_surface0</item>
        <item name="colorAddButtonIcon">@color/catppuccin_latte_mauve</item>
        <item name="colorAddedButtonBackground">@color/catppuccin_latte_surface0</item>
        <item name="colorAddedButtonIcon">@color/catppuccin_latte_green</item>
        <item name="colorSurfaceVariant">@color/catppuccin_latte_surface1</item>

        <item name="actionBarStyle">@style/MyApp.ActionBar</item>
        <item name="actionBarTheme">@style/MyApp.ActionBarTheme</item>
    </style>
    <style name="AppTheme.Catppuccin" parent="Base.AppTheme.Catppuccin" />

    <!-- Gruvbox Theme (Light: Gruvbox Light) -->
    <style name="Base.AppTheme.Gruvbox" parent="Theme.MaterialComponents.DayNight">
        <item name="colorPrimary">@color/gruvbox_light_primary</item>
        <item name="colorPrimaryVariant">@color/gruvbox_light_primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/gruvbox_light_secondary</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorAccent">@color/gruvbox_light_primary</item>

        <item name="android:windowBackground">@color/gruvbox_light_bg</item>
        <item name="colorSurface">@color/gruvbox_light_bg_hard</item>
        <item name="colorOnSurface">@color/gruvbox_light_on_bg</item>
        <item name="android:textColorPrimary">@color/gruvbox_light_on_bg</item>
        <item name="android:textColorSecondary">@color/gruvbox_light_on_surface_variant</item>

        <!-- Custom Material UI Palette Attributes -->
        <item name="colorCardSurface">@color/gruvbox_light_surface</item>
        <item name="colorCardBorder">@color/gruvbox_light_surface_variant</item>
        <item name="colorBadgeBackground">@color/gruvbox_light_surface_variant</item>
        <item name="colorBadgeText">@color/gruvbox_light_primary</item>
        <item name="colorDivider">@color/gruvbox_light_surface_variant</item>
        <item name="colorAddButtonBackground">@color/gruvbox_light_surface_variant</item>
        <item name="colorAddButtonIcon">@color/gruvbox_light_primary</item>
        <item name="colorAddedButtonBackground">@color/gruvbox_light_surface_variant</item>
        <item name="colorAddedButtonIcon">@color/gruvbox_light_secondary</item>
        <item name="colorSurfaceVariant">@color/gruvbox_light_surface_variant</item>

        <item name="actionBarStyle">@style/MyApp.ActionBar</item>
        <item name="actionBarTheme">@style/MyApp.ActionBarTheme</item>
    </style>
    <style name="AppTheme.Gruvbox" parent="Base.AppTheme.Gruvbox" />

    <!-- Modern Flat Expressive Material Action Bar -->
    <style name="MyApp.ActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="elevation">0dp</item>
        <item name="background">?attr/colorSurface</item>
        <item name="titleTextStyle">@style/MyApp.ActionBar.TitleText</item>
    </style>

    <style name="MyApp.ActionBar.TitleText" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="MyApp.ActionBarTheme" parent="ThemeOverlay.MaterialComponents.ActionBar">
        <item name="colorControlNormal">?android:attr/textColorPrimary</item>
        <item name="actionMenuTextColor">?android:attr/textColorPrimary</item>
    </style>

    <!-- Clean Modern Pill Button Typography -->
    <style name="StickerPreviewButtonText" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="sticker_packs_list_item_author_style">
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:lines">1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Modern Info Item Style -->
    <style name="InfoButtonStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingStart" tools:targetApi="jelly_bean_mr1">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:paddingEnd" tools:targetApi="jelly_bean_mr1">20dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:drawablePadding">20dp</item>
        <item name="android:clickable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

</resources>
