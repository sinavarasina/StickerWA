<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:title="@string/title_activity_sticker_pack_info"
            app:titleTextColor="?android:attr/textColorPrimary"
            app:navigationIconTint="?android:attr/textColorPrimary"
            app:elevation="0dp" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        tools:context=".StickerPackInfoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="?attr/colorCardSurface"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:strokeColor="?attr/colorCardBorder"
            app:strokeWidth="@dimen/card_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tray_icon"
                    style="@style/InfoButtonStyle"
                    android:clickable="false"
                    android:text="@string/info_screen_tray_icon"
                    android:textColor="?android:attr/textColorSecondary"
                    tools:drawableStart="@drawable/sticker_3rdparty_web" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorDivider" />

                <TextView
                    android:id="@+id/view_webpage"
                    style="@style/InfoButtonStyle"
                    android:drawableStart="@drawable/sticker_3rdparty_web"
                    android:drawableLeft="@drawable/sticker_3rdparty_web"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:drawableRight="@drawable/ic_chevron_right"
                    android:text="@string/view_webpage" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorDivider" />

                <TextView
                    android:id="@+id/send_email"
                    style="@style/InfoButtonStyle"
                    android:drawableStart="@drawable/sticker_3rdparty_email"
                    android:drawableLeft="@drawable/sticker_3rdparty_email"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:drawableRight="@drawable/ic_chevron_right"
                    android:text="@string/send_email" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorDivider" />

                <TextView
                    android:id="@+id/privacy_policy"
                    style="@style/InfoButtonStyle"
                    android:drawableStart="@drawable/sticker_3rdparty_privacy"
                    android:drawableLeft="@drawable/sticker_3rdparty_privacy"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:drawableRight="@drawable/ic_chevron_right"
                    android:text="@string/privacy_policy" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorDivider" />

                <TextView
                    android:id="@+id/license_agreement"
                    style="@style/InfoButtonStyle"
                    android:drawableStart="@drawable/sticker_3rdparty_license"
                    android:drawableLeft="@drawable/sticker_3rdparty_license"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:drawableRight="@drawable/ic_chevron_right"
                    android:text="@string/license_agreement" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
</LinearLayout>
